# ==============================================================================
# TATTVA AI - Environment Configuration Template
# ==============================================================================

# Core Application Settings & Canonical Site URL
NEXT_PUBLIC_APP_NAME="TATTVA AI"
NEXT_PUBLIC_SITE_URL="https://tattva-ai-phi.vercel.app"
NEXT_PUBLIC_APP_URL="https://tattva-ai-phi.vercel.app"

# Anthropic Claude & Model Context Protocol (MCP) Connector Integration
# Required for Claude Messages API & MCP remote servers
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# Anthropic MCP beta header (default: mcp-client-2025-11-20)
ANTHROPIC_MCP_BETA_HEADER="mcp-client-2025-11-20"

# Application Encryption Key for Encrypting MCP Tokens at Rest (AES-256-GCM)
# Generate a 32-byte hex or base64 key: openssl rand -hex 32
APP_ENCRYPTION_KEY="your-secure-32-byte-hex-encryption-key-here"

# Google Gemini / AI Orchestrator
GEMINI_API_KEY="your-gemini-api-key-here"

# Hugging Face Inference (Optional fallback)
HUGGINGFACE_API_KEY="your-huggingface-api-key-here"

# Supabase Auth & Database (Optional / SSR Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Maps Platform (Satellite, Geocoding, Places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Sentry Error Monitoring & Application Performance
# Sentry DSN from Sentry Project Settings -> Client Keys (DSN)
SENTRY_DSN="https://your-dsn@ingest.sentry.io/your-project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@ingest.sentry.io/your-project-id"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# TATTVA AI - Outlook Studio Real Email Provider (Resend or SMTP)
# 1. Resend (Recommended: https://resend.com)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="TATTVA AI <notifications@tattva-ai.com>"

# 2. Custom SMTP (Optional alternative: Amazon SES, SendGrid, Mailgun, Postmark, Gmail)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="false"
