# Local engine defaults (copy to .env and adjust)
MODEL=sdxl
MODEL_PATH=./models/sdxl
MODEL_REPO=stabilityai/stable-diffusion-xl-base-1.0
DEVICE=auto
TORCH_DTYPE=auto
PORT=8001
HOST=127.0.0.1

# 4 GB cards: keep at 0.75-1.0
MAX_MEGAPIXELS=1.0

# auto = CPU offload under 6 GB VRAM, always = force, never = keep on GPU
CPU_OFFLOAD=auto
ATTENTION_SLICING=true
VAE_SLICING=true
VAE_TILING=true
XFORMERS=true
SCHEDULER=euler
