<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration trusting system and user CAs for secure connections -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Strict HTTPS configuration for production cloud domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tattva-ai-phi.vercel.app</domain>
        <domain includeSubdomains="true">vercel.app</domain>
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
