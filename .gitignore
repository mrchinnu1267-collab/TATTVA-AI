# =============================================================================
# TATTVA AI - Root .gitignore
# Conceptualized & Engineered by kotapati Gowtham Chowdary
# =============================================================================

# Environments & Sensitive Credentials (STRICT)
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.secret

# Node.js
**/node_modules/
**/.next/
**/build/
**/dist/
**/out/
**/*.tsbuildinfo

# Python
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# AI Model Binaries & Checkpoints (Heavy Artifacts)
**/models/
**/*.safetensors
**/*.pt
**/*.pth
**/*.bin
**/*.onnx
**/.cache/

# Local Secure Vault & Memory Stores
**/.tattva_secure_vault/
**/.tattva_memory_data/
**/.tattva_studio/

# OS / Editor Files
.DS_Store
Thumbs.db
.vscode/
.cursor/
.idea/

# Logs, Telemetry & Temporary Debug Outputs
**/*.log
**/*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test Reports, Benchmarks & Validation Artifacts
**/reports/
**/validation-report.json
**/*-report.json

# Temporary Payloads & Local Scratch Probes
**/scratch/test-preview-*-payload.json
**/scratch/chat-*-req.json

# Graphify Local Output & Cache
**/graphify-out/
**/.graphify*

# Android APK binaries
*.apk
!frontend/public/*.apk
!frontend/public/*.zip

.vercel
.env*

!.env.example
!frontend/.env.example
